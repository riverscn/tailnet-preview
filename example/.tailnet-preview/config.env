# tailnet-preview configuration of the example project (docs/configuring.md, docs/design.md 5.1).

# Images built from this repository: name=Dockerfile, build context is the repository root.
IMAGES=app=example/Dockerfile

# The project's own compose file, unchanged, then what previews need on top of it.
COMPOSE_FILES=../compose.yaml compose.yaml

# What https://<node>.<tailnet>.ts.net (port 443) proxies to, and the path that must answer before the
# environment is reported ready.
HTTP=app:8080
HEALTH_PATH=/health

# DATA_VOLUMES is not set: PR environments copy every named volume (db-data) from the baseline.

# Generated once per project, the same in every environment (a copied database keeps its password).
SECRETS=DB_PASSWORD
