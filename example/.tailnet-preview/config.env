# tailnet-preview configuration of the example project (docs/design.md 5.1).

# Images built from this repository: name=Dockerfile, build context is the repository root.
IMAGES=app=example/Dockerfile

# What https://<node>.<tailnet>.ts.net (port 443) proxies to, and the path that must answer before the
# environment is reported ready.
HTTP=app:8080
HEALTH_PATH=/health

# Volumes of compose.yaml that hold data: a new PR environment starts with a copy of the baseline's.
DATA_VOLUMES=db-data

# Generated once per project, the same in every environment (a copied database keeps its password).
SECRETS=DB_PASSWORD
