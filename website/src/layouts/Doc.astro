---
import Base from './Base.astro'
import type { Lang } from '../i18n'

interface Props {
  frontmatter: { lang: Lang; title: string; description?: string }
}

const { lang, title, description } = Astro.props.frontmatter
---

<Base lang={lang} title={title} description={description}>
  <article class="container prose">
    <slot />
  </article>
</Base>

<style>
  .prose {
    max-width: 820px;
    padding-top: 48px;
  }
  .prose :global(h1) {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .prose :global(h2) {
    margin-top: 48px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }
  .prose :global(h3) {
    margin-top: 28px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(blockquote) {
    margin: 16px 0;
    padding: 4px 20px;
    border-left: 4px solid var(--accent);
    background: var(--bg-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .prose :global(li) {
    margin-bottom: 4px;
  }
</style>
