#!/usr/bin/env bash
# tailnet-preview: per-PR preview environments on your own host, reachable only via your tailnet.
# See docs/design.md for the model and the project configuration this script reads.
#
# Usage: tailnet-preview <command> [args]
#
#   build [--tag TAG]                  build the project's images (skips images that already exist)
#   has ENV                            exit 0 if the environment exists, 2 if not
#   deploy ENV [--tag TAG] [--fresh]   create or upgrade an environment; prints its URL on stdout
#   reset ENV [--tag TAG]              recreate an environment (baseline: back up first, keep its node)
#   destroy ENV [--force]              remove containers, volumes and the Tailscale node
#   stop ENV | start ENV               stop or start an environment, keeping its data
#   url ENV | info ENV | list          show URLs; info adds the tag and how the data was obtained
#   backup                             archive the baseline's DATA_VOLUMES, keep the newest KEEP_BACKUPS
#   prune [OPEN_PR_NUMBERS...]         destroy environments of closed PRs, remove unused images
#   doctor ENV                         read-only diagnostics
#   validate                           check the project configuration without deploying anything
#   init                               write a commented .tailnet-preview/ to start from
#   compose ENV ARGS...                run docker compose for an environment
#   host-check                         check the host's prerequisites
#   ingress up|down|status             the host's shared ingress (TP_INGRESS=shared, docs/design.md section 10)
#   version                            print the version
#
# ENV is "main" (the baseline) or "pr-<number>".
# Exit codes: 0 success, 1 failure, 3 a limit was hit, 4 the baseline does not exist.
set -euo pipefail

VERSION=1.0.0-dev
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)

log() { printf '[tailnet-preview] %s\n' "$*" >&2; }
die() {
  log "error: $*"
  exit 1
}

# A failure with a known cause: write "<code>\t<detail>" for the PR comment (docs/design.md section 7).
FAILURE_FILE=${TP_FAILURE_FILE:-}
fail() {
  local code=$1
  shift
  if [[ -n $FAILURE_FILE ]]; then printf '%s\t%s\n' "$code" "$*" >"$FAILURE_FILE"; fi
  die "$*"
}

# Something the PR comment should mention although the deploy succeeded: "<code>\t<detail>" (section 7).
NOTICE_FILE=${TP_NOTICE_FILE:-}
notice() {
  local code=$1
  shift
  if [[ -n $NOTICE_FILE ]]; then printf '%s\t%s\n' "$code" "$*" >"$NOTICE_FILE"; fi
  log "warning: $*"
}

# Registry access is retried: flaky links to Docker Hub reset connections independently of the code.
RETRY_DELAY=${TP_RETRY_DELAY:-15}
retry() {
  local n
  for n in 1 2 3 4 5; do
    "$@" && return 0
    ((n < 5)) || break
    log "attempt $n failed, retrying in $((n * RETRY_DELAY))s: $*"
    sleep $((n * RETRY_DELAY))
  done
  return 1
}

slugify() { tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }

# ------------------------------------------------------------------ settings and configuration

SOURCE=$(cd "${TP_SOURCE:-.}" && pwd)
CONFIG=${TP_CONFIG:-$SOURCE/.tailnet-preview}
PROJECT=$(slugify "${TP_PROJECT:-$(basename "${GITHUB_REPOSITORY:-$SOURCE}")}")
[[ -n $PROJECT ]] || die "cannot derive a project name; set TP_PROJECT"
ROOT=${TP_HOME:-$HOME/previews}/$PROJECT
HOST_CONFIG=${TP_HOST_CONFIG:-$HOME/.config/tailnet-preview/env}
SECRETS_FILE=$ROOT/secrets.env
# The sidecar image doubles as the helper for copying and archiving volumes (it has cp and tar).
TS_IMAGE=${TP_TS_IMAGE:-tailscale/tailscale:stable}
CONFIG_KEYS=" IMAGES HTTP PORTS HEALTH_PATH COMPOSE_FILES DATA_VOLUMES SECRETS MAX_ENVS MIN_FREE_MB KEEP_BACKUPS "

# config.env is parsed, not sourced: KEY=value lines, '#' comments, optional surrounding quotes.
load_config() {
  local dir=${1:-$CONFIG} line key value
  [[ -f $dir/config.env ]] || fail config "missing $dir/config.env (docs/design.md section 5)"
  IMAGES='' HTTP='' PORTS='' HEALTH_PATH=/ COMPOSE_FILES=compose.yaml DATA_VOLUMES=auto SECRETS='' MAX_ENVS=8
  MIN_FREE_MB=1536 KEEP_BACKUPS=7
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    [[ $line =~ ^[[:space:]]*$ ]] && continue
    [[ $line =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || fail config "config.env: cannot parse: $line"
    key=${BASH_REMATCH[1]}
    value=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' <<<"${BASH_REMATCH[2]}")
    [[ $CONFIG_KEYS == *" $key "* ]] || fail config "config.env: unknown key $key"
    printf -v "$key" '%s' "$value"
  done <"$dir/config.env"
  [[ -n $IMAGES ]] || fail config "config.env: IMAGES is required"
  [[ $HTTP =~ ^[a-z0-9][a-z0-9_.-]*:[0-9]+$ ]] || fail config "config.env: HTTP must be service:port, got '$HTTP'"
  local item
  for item in $PORTS; do
    [[ $item =~ ^[0-9]+=[a-z0-9][a-z0-9_.-]*:[0-9]+$ ]] || fail config "config.env: bad PORTS entry '$item'"
  done
  [[ -n $COMPOSE_FILES ]] || fail config "config.env: COMPOSE_FILES is empty"
  for item in $COMPOSE_FILES; do
    [[ -f $dir/$item ]] || fail config "config.env: COMPOSE_FILES entry '$item' does not exist (paths are relative to $dir)"
  done
  for item in $DATA_VOLUMES; do
    [[ $item =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && $item != ts-state ]] || fail config "config.env: bad DATA_VOLUMES entry '$item'"
    [[ $item != auto && $item != none ]] || [[ $DATA_VOLUMES == "$item" ]] ||
      fail config "config.env: DATA_VOLUMES=$item cannot be combined with volume names"
  done
  for item in $SECRETS; do
    [[ $item =~ ^[A-Za-z_][A-Za-z0-9_]*$ && $item != TP_* ]] || fail config "config.env: bad SECRETS name '$item'"
  done
  [[ $HEALTH_PATH == /* ]] || fail config "config.env: HEALTH_PATH must start with /"
  [[ $MAX_ENVS =~ ^[0-9]+$ && $MIN_FREE_MB =~ ^[0-9]+$ && $KEEP_BACKUPS =~ ^[0-9]+$ ]] ||
    fail config "config.env: MAX_ENVS, MIN_FREE_MB and KEEP_BACKUPS must be numbers"
}

image_var() { printf 'TP_IMAGE_%s' "$(tr '[:lower:]-' '[:upper:]_' <<<"$1")"; }

random_secret() {
  local s
  s=$(head -c 32 /dev/urandom | base64 | tr -d '/+=\n')
  printf '%s' "${s:0:40}"
}

host_setting() {
  # shellcheck disable=SC1090
  [[ -f $HOST_CONFIG ]] && (set -a && source "$HOST_CONFIG" && printf '%s' "${!1:-}")
}

# Secrets: generated once per project on the host, the same for every environment, so a copied database
# and the services of the new environment agree on them. TS_OAUTH_SECRET comes from the environment (a
# repository secret) or the machine-wide host configuration.
load_secrets_ts() {
  TS_OAUTH_SECRET=${TS_OAUTH_SECRET:-$(host_setting TS_OAUTH_SECRET || true)}
  [[ -n $TS_OAUTH_SECRET ]] ||
    fail ts_secret "no TS_OAUTH_SECRET: put it in $HOST_CONFIG or a repository secret (docs/host-setup.md)"
  TS_TAGS=${TS_TAGS:-$(host_setting TS_TAGS || true)}
  TS_TAGS=${TS_TAGS:-tag:preview}
}

load_secrets() {
  local name
  load_secrets_ts
  mkdir -p "$ROOT"
  (umask 077 && touch "$SECRETS_FILE")
  for name in $SECRETS; do
    grep -q "^$name=" "$SECRETS_FILE" || {
      printf '%s=%s\n' "$name" "$(random_secret)" >>"$SECRETS_FILE"
      log "generated $name"
    }
  done
  chmod 600 "$SECRETS_FILE"
  set -a
  # shellcheck disable=SC1090
  source "$SECRETS_FILE"
  set +a
}

# ------------------------------------------------------------------ images

pull_missing() {
  local image
  for image in $("$@" config --images); do
    [[ $image == "$PROJECT"-* ]] && continue
    docker image inspect "$image" >/dev/null 2>&1 && continue
    log "pulling $image"
    retry docker pull -q "$image" >/dev/null ||
      fail registry "pulling $image failed (the host's connection to the registry, docs/troubleshooting.md)"
  done
}

default_tag() { git -C "$SOURCE" rev-parse HEAD 2>/dev/null | cut -c1-12; }

images_exist() {
  local tag=$1 entry
  for entry in $IMAGES; do
    docker image inspect "$PROJECT-${entry%%=*}:$tag" >/dev/null 2>&1 || return 1
  done
}

cmd_build() {
  local tag=''
  while (($#)); do
    case $1 in
      --tag) tag=$2 && shift 2 ;;
      *) die "build: unknown argument $1" ;;
    esac
  done
  load_config
  tag=${tag:-$(default_tag)}
  [[ -n $tag ]] || die "build: no --tag and $SOURCE is not a git checkout"
  if images_exist "$tag"; then
    log "images $tag already exist"
    return
  fi
  local entry name file
  for entry in $IMAGES; do
    name=${entry%%=*} file=${entry#*=}
    [[ $entry == *=* && -f $SOURCE/$file ]] || fail config "config.env: IMAGES entry '$entry': no such Dockerfile in $SOURCE"
    log "building $PROJECT-$name:$tag from $file"
    retry docker build --label "tailnet-preview.project=$PROJECT" -t "$PROJECT-$name:$tag" -f "$SOURCE/$file" "$SOURCE" >&2 ||
      fail build "building image $name failed"
  done
}

# ------------------------------------------------------------------ environments

check_name() { [[ $1 == main || $1 =~ ^pr-[0-9]+$ ]] || die "environment must be main or pr-<number>, got '$1'"; }

env_dir() { printf '%s/envs/%s' "$ROOT" "$1"; }

# The URL comes from the sidecar's real node name after login (resolve_url), so the tailnet's domain is
# never configured.
app_url() { cat "$(env_dir "$1")/url" 2>/dev/null || echo '(unknown)'; }

compose_env() {
  local dir
  dir=$(env_dir "$1")
  shift
  local files=() file
  while IFS= read -r file; do files+=(-f "$file"); done <"$dir/compose-files"
  docker compose --project-directory "$(cat "$dir/project-dir")" --env-file "$dir/compose.env" "${files[@]}" "$@"
}

# The configuration directory's path inside the repository (".tailnet-preview" if it lies outside).
config_rel() {
  local rel
  rel=$(realpath -m --relative-to="$SOURCE" "$CONFIG")
  [[ $rel != ..* && $rel != /* ]] || rel=.tailnet-preview
  printf '%s' "$rel"
}

# The volumes whose data a PR environment copies from the baseline: DATA_VOLUMES, or every named volume.
data_volumes() {
  case $DATA_VOLUMES in
    auto) compose_env "$1" config --volumes | grep -vx ts-state || true ;;
    '' | none) ;;
    *) tr -s ' ' '\n' <<<"$DATA_VOLUMES" ;;
  esac
}

# Created successfully at least once. A half-created environment is recreated, not upgraded.
env_exists() { [[ -f $(env_dir "$1")/initialized ]]; }

pr_env_count() { find "$ROOT/envs" -mindepth 1 -maxdepth 1 -type d -name 'pr-*' 2>/dev/null | wc -l; }

free_mb() { awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo; }

# Capture, then match: with pipefail, piping into a reader that exits early (grep -q) fails when the writer gets SIGPIPE.
has_task() {
  local services
  services=$(compose_env "$1" --profile tasks config --services 2>/dev/null) || return 1
  grep -qx "$2" <<<"$services"
}

# Services that stay running (default profile), except the sidecar.
app_services() { compose_env "$1" config --services | grep -vx ts || true; }

stop_services() {
  local services
  services=$(app_services "$1")
  # shellcheck disable=SC2086
  [[ -z $services ]] || compose_env "$1" stop $services >&2
}

start_services() {
  local services
  services=$(app_services "$1")
  # shellcheck disable=SC2086
  [[ -z $services ]] || compose_env "$1" start $services >&2
}

# The Docker volume behind a compose volume of an environment (found by compose's labels).
volume_of() {
  docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT-$1" \
    --filter "label=com.docker.compose.volume=$2"
}

# Remove an environment's containers and volumes, keeping the Tailscale node (ts and its state).
wipe_data() {
  local name=$1 volume
  if [[ -f $(env_dir "$name")/compose-files ]]; then
    local services
    services=$(compose_env "$name" --profile tasks config --services | grep -vx ts || true)
    # shellcheck disable=SC2086
    [[ -z $services ]] || compose_env "$name" --profile tasks rm -f -s $services >&2
  fi
  for volume in $(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT-$name"); do
    [[ $(docker volume inspect -f '{{index .Labels "com.docker.compose.volume"}}' "$volume") == ts-state ]] && continue
    docker volume rm "$volume" >/dev/null
  done
}

serve_json() {
  local tcp web entry port target
  tcp="\"443\": { \"HTTPS\": true }"
  web="\"\${TS_CERT_DOMAIN}:443\": { \"Handlers\": { \"/\": { \"Proxy\": \"http://$HTTP\" } } }"
  for entry in $PORTS; do
    port=${entry%%=*} target=${entry#*=}
    tcp+=", \"$port\": { \"HTTPS\": true }"
    web+=", \"\${TS_CERT_DOMAIN}:$port\": { \"Handlers\": { \"/\": { \"Proxy\": \"http://$target\" } } }"
  done
  printf '{\n  "TCP": { %s },\n  "Web": { %s }\n}\n' "$tcp" "$web"
}

# tailscaled requests a certificate whenever its serve configuration has HTTPS but the certificate is
# missing: when the configuration loads, hourly, and on every TLS handshake, i.e. every browser visit. Each
# failure spends one of Let's Encrypt's five per name and hour, so the sidecar serves only once the
# certificate exists (docs/design.md section 7). serve.json stays where the engine writes it (/config, read
# only); this switch, run in the sidecar by the engine and by the retry loop, copies it to TS_SERVE_CONFIG
# ("on") or serves nothing ("off"). By rename: containerboot rereads the directory on every change and
# exits on half a file.
# shellcheck disable=SC2016 # expanded by the container's shell
SERVE_SWITCH='f=/var/lib/tailscale/tp-serve.json
if [ "$1" = on ]; then cp /config/serve.json $f.tmp; else echo "{}" >$f.tmp; fi && mv $f.tmp $f'

serve_https() {
  local name=$1 state=$2
  compose_env "$name" exec -T ts sh -c "$SERVE_SWITCH" _ "$state" >&2 ||
    log "warning: $name: could not switch HTTPS $state in the sidecar"
}

# A copy of the repository's working tree (tracked and untracked files that git does not ignore) with the
# configuration directory on top. Compose files run from it, so relative paths keep working after the
# checkout is gone, and an environment can be restarted at any time.
snapshot() {
  local dir=$1 rel
  rm -rf "$dir/src" && mkdir -p "$dir/src"
  if git -C "$SOURCE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$SOURCE" ls-files -z -c -o --exclude-standard |
      (cd "$SOURCE" && tar --null --ignore-failed-read -T - -cf - 2>/dev/null) | tar -x -C "$dir/src"
  else
    tar -C "$SOURCE" --exclude=.git -cf - . | tar -x -C "$dir/src"
  fi
  rel=$(config_rel)
  rm -rf "${dir:?}/src/$rel" && mkdir -p "$(dirname "$dir/src/$rel")"
  cp -R "$CONFIG" "$dir/src/$rel"
  printf '%s\n' "$dir/src/$rel" >"$dir/config-dir"
}

# The files compose merges for the environment: the sidecar overlay, COMPOSE_FILES in order, and an
# isolation override that removes published ports and fixed container names, which would collide between
# environments. Relative paths in all of them resolve against the first COMPOSE_FILES entry's directory.
write_compose_files() {
  local dir=$1 config file abs services service
  config=$(cat "$dir/config-dir")
  if [[ $INGRESS == shared ]]; then
    cp "$LIB/compose.overlay.shared.yaml" "$dir/overlay.yaml"
  else
    cp "$LIB/compose.overlay.yaml" "$dir/overlay.yaml"
  fi
  rm -f "$dir/project-dir.new"
  printf '%s\n' "$dir/overlay.yaml" >"$dir/compose-files"
  for file in $COMPOSE_FILES; do
    abs=$(realpath -m "$config/$file")
    [[ $abs == "$dir/src/"* && -f $abs ]] || fail config "config.env: COMPOSE_FILES entry '$file' is not a file of the repository"
    [[ -f $dir/project-dir.new ]] || dirname "$abs" >"$dir/project-dir.new"
    printf '%s\n' "$abs" >>"$dir/compose-files"
  done
  mv "$dir/project-dir.new" "$dir/project-dir"
  services=$(compose_env "$(basename "$dir")" --profile tasks config --services) ||
    fail config "the compose files do not merge (run: tailnet-preview validate)"
  {
    echo "# Written by tailnet-preview: environments must not publish ports or share container names."
    echo "services:"
    for service in $services; do
      printf '  %s:\n    ports: !reset []\n    container_name: !reset null\n' "$service"
    done
  } >"$dir/isolation.yaml"
  printf '%s\n' "$dir/isolation.yaml" >>"$dir/compose-files"
}

# Write the interpolation variables and the compose file list. Called twice per deploy: before the
# sidecar is up (URL may be unknown) and after (final URL); the snapshot is taken on the first call.
write_env() {
  local name=$1 tag=$2 dir ephemeral entry var url
  dir=$(env_dir "$name")
  mkdir -p "$dir/tailscale"
  [[ ${3:-} != --snapshot ]] || snapshot "$dir"
  serve_json >"$dir/tailscale/serve.json"
  # The baseline's node is persistent (stable address); PR nodes are ephemeral and vanish when removed.
  ephemeral=$([[ $name == main ]] && echo false || echo true)
  url=$(cat "$dir/url" 2>/dev/null || true)
  {
    printf 'COMPOSE_PROJECT_NAME=%s\n' "$PROJECT-$name"
    printf 'TP_PROJECT=%s\nTP_ENV=%s\nTP_URL=%s\nTP_HOSTNAME=%s\nTP_ENV_DIR=%s\nTP_TS_IMAGE=%s\n' \
      "$PROJECT" "$name" "$url" "$PROJECT-$name" "$dir" "$TS_IMAGE"
    printf 'TP_TS_AUTHKEY=%s?ephemeral=%s&preauthorized=true\nTP_TS_TAGS=%s\n' "$TS_OAUTH_SECRET" "$ephemeral" "$TS_TAGS"
    for entry in $IMAGES; do
      printf '%s=%s\n' "$(image_var "${entry%%=*}")" "$PROJECT-${entry%%=*}:$tag"
    done
    for var in $SECRETS; do
      printf '%s=%s\n' "$var" "${!var}"
    done
  } >"$dir/compose.env.new"
  chmod 600 "$dir/compose.env.new"
  mv "$dir/compose.env.new" "$dir/compose.env"
  write_compose_files "$dir"
  printf '%s\n' "$tag" >"$dir/tag"
}

# Start the sidecar, wait until it is logged in, record its HTTPS address. In `tailscale status --json`,
# Self's DNSName comes before the peers'.
resolve_url() {
  local name=$1 dir json dns i
  dir=$(env_dir "$name")
  pull_missing compose_env "$name"
  compose_env "$name" up -d ts >&2
  for ((i = 0; i < 60; i++)); do
    json=$(compose_env "$name" exec -T ts tailscale status --json 2>/dev/null || true)
    if grep -q '"BackendState": *"Running"' <<<"$json"; then
      dns=$(grep -m1 -o '"DNSName": *"[^"]*"' <<<"$json" | sed -E 's/.*"([^"]*)"$/\1/; s/\.$//')
      if [[ -n $dns ]]; then
        printf 'https://%s\n' "$dns" >"$dir/url"
        return
      fi
    fi
    sleep 2
  done
  fail ts_login "$name: the Tailscale sidecar did not log in within two minutes (docker logs $PROJECT-$name-ts-1)"
}

prepare_env() {
  local name=$1 tag=$2
  if [[ $INGRESS == shared ]]; then
    # The address is known up front: <project>-<env>.<TP_INGRESS_DOMAIN>.
    mkdir -p "$(env_dir "$name")"
    printf 'https://%s\n' "$(ingress_host "$name")" >"$(env_dir "$name")/url"
    retire_sidecar "$name"
    local entry ports=()
    for entry in $PORTS; do ports+=("${entry%%=*}"); done
    ensure_ingress "${ports[@]}"
    write_env "$name" "$tag" --snapshot
    return
  fi
  [[ ! -f $INGRESS_DIR/routes/$PROJECT-$name.yml ]] || ingress_unroute "$name"
  write_env "$name" "$tag" --snapshot
  resolve_url "$name"
  write_env "$name" "$tag"
}

run_task() {
  local name=$1 task=$2
  has_task "$name" "$task" || return 0
  log "$name: running $task"
  compose_env "$name" --profile tasks run --rm "$task" >&2 || fail "$task" "$name: $task failed"
}

# The tailnet issues HTTPS certificates only if they are enabled; then CertDomains lists the node's name.
# A sidecar that is (re)starting reports no CertDomains yet, so wait until it runs before deciding.
https_enabled() {
  local status i
  for ((i = 0; i < ${TP_LOGIN_TIMEOUT:-120} / 2; i++)); do
    status=$(compose_env "$1" exec -T ts tailscale status --json 2>/dev/null) || status=''
    status=$(tr -d ' \t\n' <<<"$status")
    [[ $status == *'"BackendState":"Running"'* ]] && break
    sleep 2
  done
  [[ $status == *'"CertDomains":["'* ]]
}

# Have the sidecar request its HTTPS certificate now instead of on the first visit, where a failure only
# shows as a TLS error in the browser (docs/design.md section 7). tailscaled caches it, so serve uses it and
# later deploys return at once. One attempt only: a retry publishes a new DNS record that Let's Encrypt
# again validates at once, and spends one of its five failed validations per name and hour. Prints the
# error, with Let's Encrypt's reason when it can be fetched, on failure.
issue_cert() {
  local name=$1 domain out order reason rc=0 limit=${TP_CERT_TIMEOUT:-60} gap=${TP_CERT_MIN_GAP:-360} failed
  domain=$(app_url "$name")
  domain=${domain#https://}
  # A new deploy supersedes the previous one: stop its background loop and any certificate request still
  # running, which would make this one wait for it. ([c] keeps pkill from matching this shell's command line.)
  # shellcheck disable=SC2016 # expanded by the container's shell
  compose_env "$name" exec -T ts sh -c \
    'pid=/tmp/tp-cert-retry.pid; [ -f $pid ] && kill "$(cat $pid)"; rm -f $pid; pkill -f "tailscale [c]ert"' \
    >/dev/null 2>&1 || true
  # A certificate tailscaled already has comes back without asking Let's Encrypt; otherwise a request has to
  # be worth one of the five failures.
  if ! compose_env "$name" exec -T ts test -s "/var/lib/tailscale/certs/$domain.crt" >/dev/null 2>&1; then
    # While Let's Encrypt refuses the name, another request would only extend the refusal; the loop waits.
    local blocked_until
    blocked_until=$(cert_rate_limit_until "$name" "$domain")
    if [[ -n $blocked_until ]]; then
      out="rateLimited: Let's Encrypt refuses new requests for this name until $(date -u -d "@$blocked_until" '+%F %T') UTC"
      log "$name: certificate for $domain not requested: $out"
      printf '%s' "$out"
      return 1
    fi
    # Let's Encrypt's resolvers remember a missing validation record for up to five minutes (the negative
    # TTL of ts.net), so a request soon after a failed one fails the same way.
    failed=$(compose_env "$name" exec -T ts cat /var/lib/tailscale/tp-cert-failed 2>/dev/null) || failed=''
    if [[ $failed =~ ^[0-9]+$ ]] && (($(date +%s) - failed < gap)); then
      out="the previous request failed $(($(date +%s) - failed))s ago and Let's Encrypt may still see the validation record as missing; the sidecar requests again later"
      log "$name: certificate for $domain not requested: $out"
      printf '%s' "$out"
      return 1
    fi
  fi
  # Bounded: when Let's Encrypt or Tailscale is slow, the background loop takes over instead of the deploy.
  # shellcheck disable=SC2016 # expanded by the container's shell
  out=$(compose_env "$name" exec -T ts timeout "$limit" sh -c \
    'tailscale cert --cert-file /tmp/tp.crt --key-file /tmp/tp.key "$1"; rc=$?; rm -f /tmp/tp.crt /tmp/tp.key; exit $rc' \
    _ "$domain" 2>&1) || rc=$?
  ((rc != 0)) || return 0
  compose_env "$name" exec -T ts sh -c 'date +%s >/var/lib/tailscale/tp-cert-failed' >/dev/null 2>&1 || true
  # "order ... status: invalid" does not say why; the order's authorization does. The order is not always
  # on the last line.
  order=$(grep -oE 'https://acme[^ ]*/order/[0-9]+/[0-9]+' <<<"$out" | sed -n 1p) || true
  out=$(tail -n 1 <<<"$out")
  # BusyBox timeout ends the command with SIGTERM (exit 143).
  if ((rc == 143 || rc == 124)); then out="no answer within ${limit}s (a request for this name may still be running)"; fi
  if [[ -n $order ]]; then
    reason=$(acme_reason "$name" "$order") || true
    [[ -z $reason ]] || out="$reason"
  fi
  log "$name: certificate for $domain not issued: $out"
  printf '%s' "${out:0:300}"
  return 1
}

# The time (epoch seconds) until which Let's Encrypt refuses requests for the domain, from the last rate-limit
# error in the sidecar's log ("too many failed authorizations (5) ... retry after <time> UTC"); empty if none
# is pending.
cert_rate_limit_until() {
  local name=$1 domain=$2 when t
  when=$(grep -F "cert(\"$domain\")" <<<"$(compose_env "$name" logs --no-color --no-log-prefix ts 2>/dev/null)" |
    sed -n 's/.*rateLimited.*retry after \([0-9-]* [0-9:]*\) UTC.*/\1/p' | tail -n 1) || true
  [[ -n $when ]] || return 0
  t=$(date -u -d "$when" +%s 2>/dev/null) || return 0
  if ((t > $(date +%s))); then printf '%s' "$t"; fi
}

# Request the certificate again later, from a loop inside the sidecar so that it outlives the deploy job:
# after 6, 26 and 71 minutes, then hourly for a day. A rate limit ("retry after <time> UTC") is waited out
# first, by the loop and by the first attempt, since requests meanwhile only extend it; so is the
# TP_CERT_MIN_GAP after a failure. Once issued, the loop switches HTTPS on. A new deploy replaces the loop;
# the loop ends with the sidecar. Progress: /var/lib/tailscale/tp-cert-retry.log (doctor prints it).
retry_cert_later() {
  local name=$1 domain delays blocked_until margin=${TP_CERT_RATE_LIMIT_MARGIN:-30} gap=${TP_CERT_MIN_GAP:-360} first
  domain=$(app_url "$name")
  domain=${domain#https://}
  delays=${TP_CERT_RETRY_DELAYS:-360 1200 2700 $(printf '3600 %.0s' {1..21})}
  blocked_until=$(cert_rate_limit_until "$name" "$domain")
  if [[ -n $blocked_until ]]; then
    first=$((blocked_until - $(date +%s) + margin))
    if ((first > ${delays%% *})); then delays="$first ${delays#* }"; fi
  fi
  # shellcheck disable=SC2016,SC2086 # expanded by the container's shell; the delays are words
  compose_env "$name" exec -d ts sh -c '
    serve_switch() { sh -c "$switch" _ "$1"; }
    domain=$1 margin=$2 gap=$3 switch=$4; shift 4; log=/var/lib/tailscale/tp-cert-retry.log; pid=/tmp/tp-cert-retry.pid
    failed=/var/lib/tailscale/tp-cert-failed
    [ -f $pid ] && kill "$(cat $pid)" 2>/dev/null
    echo $$ >$pid
    skip=0
    for delay in "$@"; do
      if [ $skip = 0 ]; then
        echo "$(date -u +%FT%TZ) next attempt in ${delay}s" >>$log
        sleep "$delay"
      fi
      skip=0
      last=$(cat $failed 2>/dev/null); hold=$((${last:-0} + gap - $(date +%s)))
      if [ $hold -gt 0 ]; then
        echo "$(date -u +%FT%TZ) the last failure is too recent, waiting ${hold}s" >>$log
        sleep $hold
      fi
      if out=$(tailscale cert --cert-file /tmp/tp.crt --key-file /tmp/tp.key "$domain" 2>&1); then
        rm -f /tmp/tp.crt /tmp/tp.key $pid $failed
        serve_switch on
        echo "$(date -u +%FT%TZ) issued, HTTPS on" >>$log
        exit 0
      fi
      date +%s >$failed
      echo "$(date -u +%FT%TZ) failed: $(echo "$out" | tail -n 1)" >>$log
      when=$(echo "$out" | sed -n "s/.*rateLimited.*retry after \([0-9-]* [0-9:]*\) UTC.*/\1/p" | tail -n 1)
      if [ -n "$when" ] && t=$(date -u -d "$when" +%s 2>/dev/null) && [ "$t" -gt "$(date +%s)" ]; then
        echo "$(date -u +%FT%TZ) rate limited until $when UTC, waiting" >>$log
        sleep $((t - $(date +%s) + margin))
        skip=1
      fi
    done
    rm -f $pid
    echo "$(date -u +%FT%TZ) gave up" >>$log' _ "$domain" "$margin" "$gap" "$SERVE_SWITCH" $delays >&2
}

# The error of a failed Let's Encrypt order, from its public authorization; fetched by the sidecar, which
# has network access and wget. Empty when it cannot be fetched.
acme_reason() {
  local name=$1 order=$2 json authz
  json=$(compose_env "$name" exec -T ts wget -q -O - "$order" 2>/dev/null) || return 0
  authz=$(grep -oE 'https://[^"]*/authz/[^"]*' <<<"$json" | sed -n 1p)
  [[ -n $authz ]] || return 0
  json=$(compose_env "$name" exec -T ts wget -q -O - "$authz" 2>/dev/null) || return 0
  grep -oE '"detail": *"([^"\\]|\\.)*"' <<<"$json" | sed -n '1{s/^"detail": *"//;s/"$//;s/\\"/"/g;p}'
}

# ------------------------------------------------------------------ shared ingress (docs/design.md section 10)

# Host-wide settings, from the environment or the host configuration. TP_INGRESS=sidecar (default) gives
# every environment its own Tailscale node and certificate; shared routes every environment of every
# project on the host through one ingress with one wildcard certificate.
load_ingress_settings() {
  local var
  for var in TP_INGRESS TP_INGRESS_DOMAIN TP_INGRESS_DNS_PROVIDER TP_INGRESS_DNS_ENV TP_INGRESS_ACME_EMAIL \
    TP_INGRESS_ACME_CA TP_INGRESS_HOSTNAME; do
    [[ -n ${!var:-} ]] || printf -v "$var" '%s' "$(host_setting "$var" || true)"
  done
  INGRESS=${TP_INGRESS:-sidecar}
  case $INGRESS in
    sidecar) return ;;
    shared) ;;
    *) fail config "TP_INGRESS must be sidecar or shared, got '$INGRESS'" ;;
  esac
  INGRESS_DOMAIN=${TP_INGRESS_DOMAIN:-}
  [[ $INGRESS_DOMAIN =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] ||
    fail config "TP_INGRESS=shared needs TP_INGRESS_DOMAIN, e.g. preview.example.com (docs/host-setup.md)"
  if [[ -n ${TP_INGRESS_DNS_PROVIDER:-} && -z ${TP_INGRESS_ACME_EMAIL:-} ]]; then
    fail config "TP_INGRESS_DNS_PROVIDER needs TP_INGRESS_ACME_EMAIL, Let's Encrypt's contact address"
  fi
  INGRESS_HOSTNAME=${TP_INGRESS_HOSTNAME:-tailnet-preview-$(hostname -s | tr '[:upper:]' '[:lower:]')}
}

INGRESS_DIR=${TP_HOME:-$HOME/previews}/.ingress
INGRESS_PROJECT=${TP_INGRESS_PROJECT:-tailnet-preview-ingress}
TRAEFIK_IMAGE=${TP_TRAEFIK_IMAGE:-traefik:v3.7}
COREDNS_IMAGE=${TP_COREDNS_IMAGE:-coredns/coredns:1.14.7}

compose_ingress() {
  docker compose --project-directory "$INGRESS_DIR" -p "$INGRESS_PROJECT" --env-file "$INGRESS_DIR/ingress.env" \
    -f "$INGRESS_DIR/compose.yaml" "$@"
}
ingress_container() { printf '%s-%s-1' "$INGRESS_PROJECT" "$1"; }
ingress_exec() { docker exec "$(ingress_container ts)" "$@"; }

# Replace a file only when its content changes (by rename, so readers never see half of it). True if it did.
write_if_changed() {
  local file=$1 new
  new=$(cat)
  [[ -f $file && $(cat "$file") == "$new" ]] && return 1
  printf '%s\n' "$new" >"$file.new" && mv "$file.new" "$file"
}

# The ingress's tailnet IPv4 address, once its node is logged in.
ingress_ip() {
  local i ip
  for ((i = 0; i < ${TP_LOGIN_TIMEOUT:-120} / 2; i++)); do
    ip=$(ingress_exec tailscale ip -4 2>/dev/null | sed -n 1p) || ip=''
    if [[ $ip =~ ^[0-9.]+$ ]]; then
      printf '%s' "$ip"
      return
    fi
    sleep 2
  done
  fail ts_login "the ingress's Tailscale node did not log in within two minutes (docker logs $(ingress_container ts))"
}

# Start or update the ingress; extra arguments are ports (besides 443) that need an entry point. Every
# project's deploy calls it, so the ingress follows the newest engine that ran on the host.
ensure_ingress() {
  local port ports ip restart=0 var
  mkdir -p "$INGRESS_DIR"/{traefik,routes,coredns}
  exec 8>"$INGRESS_DIR/.lock"
  flock -w 600 8 || die "timed out waiting for the ingress lock"
  cp "$LIB/ingress/compose.yaml" "$INGRESS_DIR/compose.yaml"
  (
    umask 077
    printf 'TP_TS_IMAGE=%s\nTP_TRAEFIK_IMAGE=%s\nTP_COREDNS_IMAGE=%s\nTP_INGRESS_HOSTNAME=%s\n' \
      "$TS_IMAGE" "$TRAEFIK_IMAGE" "$COREDNS_IMAGE" "$INGRESS_HOSTNAME"
    printf 'TP_TS_AUTHKEY=%s?ephemeral=false&preauthorized=true\nTP_TS_TAGS=%s\n' "$TS_OAUTH_SECRET" "$TS_TAGS"
  ) >"$INGRESS_DIR/ingress.env"
  # The DNS provider's credentials (named in TP_INGRESS_DNS_ENV) for Traefik's DNS-01 challenge.
  (
    umask 077
    for var in ${TP_INGRESS_DNS_ENV:-}; do
      [[ -n ${!var:-} ]] || printf -v "$var" '%s' "$(host_setting "$var" || true)"
      [[ -n ${!var:-} ]] || fail config "TP_INGRESS_DNS_ENV names $var, but it is not set (docs/host-setup.md)"
      printf '%s=%s\n' "$var" "${!var}"
    done
  ) >"$INGRESS_DIR/dns.env" || exit 1
  ports=$( (cat "$INGRESS_DIR/ports" 2>/dev/null || true; printf '%s\n' 443 "$@") | grep -E '^[0-9]+$' | sort -nu)
  printf '%s\n' "$ports" >"$INGRESS_DIR/ports"
  pull_missing compose_ingress
  compose_ingress up -d ts >&2
  ip=$(ingress_ip)
  printf '%s\n' "$ip" >"$INGRESS_DIR/ip"
  {
    echo "# Written by tailnet-preview (docs/design.md section 10). Static: changes restart Traefik."
    echo "entryPoints:"
    for port in $ports; do printf '  p%s:\n    address: "%s:%s"\n' "$port" "$ip" "$port"; done
    printf 'providers:\n  file:\n    directory: /routes\n    watch: true\n'
    if [[ -n ${TP_INGRESS_DNS_PROVIDER:-} ]]; then
      printf 'certificatesResolvers:\n  le:\n    acme:\n      email: "%s"\n      storage: /data/acme.json\n' "$TP_INGRESS_ACME_EMAIL"
      [[ -z ${TP_INGRESS_ACME_CA:-} ]] || printf '      caServer: "%s"\n' "$TP_INGRESS_ACME_CA"
      # Let's Encrypt validates only once every authoritative name server has the record.
      printf '      dnsChallenge:\n        provider: %s\n        propagation:\n          requireAllRNS: true\n' "$TP_INGRESS_DNS_PROVIDER"
    fi
    printf 'log:\n  level: INFO\n'
  } | write_if_changed "$INGRESS_DIR/traefik/traefik.yml" && restart=1
  # Every name under the domain is the ingress; AAAA gets an empty answer, not an error.
  printf '%s:53 {\n  bind %s\n  template IN A {\n    answer "{{ .Name }} 60 IN A %s"\n  }\n  template IN AAAA {\n    rcode NOERROR\n  }\n  reload 10s\n  errors\n}\n' \
    "$INGRESS_DOMAIN" "$ip" "$ip" | write_if_changed "$INGRESS_DIR/coredns/Corefile" || true
  compose_ingress up -d >&2
  if ((restart)); then compose_ingress restart traefik >&2; fi
  exec 8>&-
}

# The container behind service:port of an environment, as the ingress reaches it over the environment's
# network (compose names containers <project>-<env>-<service>-1).
upstream_of() { printf '%s-%s-%s-1:%s' "$PROJECT" "$1" "${2%%:*}" "${2#*:}"; }

networks_of() { docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$1" 2>/dev/null || true; }

ingress_host() { printf '%s-%s.%s' "$PROJECT" "$1" "$INGRESS_DOMAIN"; }

# Connect the ingress to the networks of the environment's HTTP and PORTS services and route its name to
# them: 443 to HTTP, every PORTS entry to its target.
ingress_route() {
  local name=$1 entry port target container net ts host tls file
  ts=$(ingress_container ts) host=$(ingress_host "$name")
  file=$INGRESS_DIR/routes/$PROJECT-$name.yml
  tls='tls: {}'
  [[ -z ${TP_INGRESS_DNS_PROVIDER:-} ]] ||
    tls="tls: { certResolver: le, domains: [{ main: \"*.$INGRESS_DOMAIN\" }] }"
  {
    echo "# Written by tailnet-preview for $PROJECT $name."
    echo "http:"
    echo "  routers:"
    for entry in "443=$HTTP" $PORTS; do
      port=${entry%%=*}
      # shellcheck disable=SC2016 # Traefik's rule syntax quotes with backticks
      printf '    %s-%s-%s:\n      rule: Host(`%s`)\n      entryPoints: [p%s]\n      service: %s-%s-%s\n      %s\n' \
        "$PROJECT" "$name" "$port" "$host" "$port" "$PROJECT" "$name" "$port" "$tls"
    done
    echo "  services:"
    for entry in "443=$HTTP" $PORTS; do
      port=${entry%%=*} target=${entry#*=}
      printf '    %s-%s-%s:\n      loadBalancer:\n        servers:\n          - url: http://%s\n' \
        "$PROJECT" "$name" "$port" "$(upstream_of "$name" "$target")"
    done
  } | write_if_changed "$file" || true
  for entry in "443=$HTTP" $PORTS; do
    target=${entry#*=} container=$(upstream_of "$name" "${entry#*=}") container=${container%:*}
    for net in $(networks_of "$container"); do
      [[ " $(networks_of "$ts") " == *" $net "* ]] ||
        docker network connect "$net" "$ts" >&2 ||
        fail health "$name: could not connect the ingress to the network $net of $target"
    done
  done
}

# Remove an environment's routes and disconnect the ingress from its networks (compose cannot remove a
# network the ingress is still connected to).
ingress_unroute() {
  local name=$1 net ts
  ts=$(ingress_container ts)
  rm -f "$INGRESS_DIR/routes/$PROJECT-$name.yml"
  for net in $(networks_of "$ts"); do
    [[ $net == "$PROJECT-${name}_"* ]] && docker network disconnect "$net" "$ts" >/dev/null 2>&1 || true
  done
}

# An environment deployed with its own sidecar before the host switched to the shared ingress: its node
# leaves the tailnet and the sidecar and its state go.
retire_sidecar() {
  local name=$1 c volume
  c=$PROJECT-$name-ts-1
  docker inspect "$c" >/dev/null 2>&1 || return 0
  log "$name: moving to the shared ingress, removing its Tailscale sidecar"
  docker exec "$c" tailscale logout >/dev/null 2>&1 || true
  docker rm -f "$c" >/dev/null
  volume=$(volume_of "$name" ts-state)
  [[ -z $volume ]] || docker volume rm "$volume" >/dev/null || true
}

# Request the health path through the same upstream the sidecar proxies to; new backends need a moment.
wait_healthy() {
  local name=$1 i svc
  for ((i = 0; i < ${TP_HEALTH_TIMEOUT:-120} / 2; i++)); do
    if [[ $INGRESS == shared ]]; then
      # Through Traefik, as a browser would: it also waits until Traefik has loaded the route.
      ingress_exec wget --no-check-certificate -q -O /dev/null --header "Host: $(ingress_host "$name")" \
        "https://$(cat "$INGRESS_DIR/ip")$HEALTH_PATH" 2>/dev/null && return 0
    else
      compose_env "$name" exec -T ts wget -q -O /dev/null "http://$HTTP$HEALTH_PATH" 2>/dev/null && return 0
    fi
    sleep 2
  done
  for svc in $(app_services "$name"); do
    log "== logs of $svc"
    compose_env "$name" logs --no-color --tail 30 "$svc" >&2 || true
  done
  fail health "$name: http://$HTTP$HEALTH_PATH did not answer within ${TP_HEALTH_TIMEOUT:-120}s (logs above)"
}

# Copy the baseline's DATA_VOLUMES into a new environment whose containers and volumes exist but have not
# started. The baseline's services stop meanwhile, so nothing writes to the volumes during the copy, and
# start again whether or not it worked.
copy_data() {
  local name=$1 volumes=$2 volume from to rc=0
  compose_env "$name" create >&2
  log "$name: copying ${volumes//$'\n'/ } from the baseline (the baseline pauses meanwhile)"
  stop_services main
  for volume in $volumes; do
    from=$(volume_of main "$volume") to=$(volume_of "$name" "$volume")
    if [[ -z $from || -z $to ]]; then
      log "volume $volume: baseline '${from:-missing}', $name '${to:-missing}'"
      rc=1 && break
    fi
    docker run --rm --entrypoint sh -v "$from:/from:ro" -v "$to:/to" "$TS_IMAGE" \
      -c 'find /to -mindepth 1 -delete && cp -a /from/. /to/' >&2 || { rc=1 && break; }
  done
  start_services main
  ((rc == 0)) || fail fork "$name: copying the volume $volume from the baseline failed (is it in compose.yaml's volumes?)"
}

# Empty volumes -> migrate -> seed. Used for the baseline and for PRs without a baseline to copy.
create_fresh() {
  local name=$1 tag=$2
  log "$name: creating with empty volumes"
  wipe_data "$name"
  prepare_env "$name" "$tag"
  run_task "$name" migrate
  run_task "$name" seed
  compose_env "$name" up -d --remove-orphans >&2
  echo fresh >"$(env_dir "$name")/mode"
}

create_forked() {
  local name=$1 tag=$2 volumes
  wipe_data "$name"
  prepare_env "$name" "$tag"
  volumes=$(data_volumes "$name")
  if [[ -z $volumes ]]; then
    log "$name: no data volumes to copy (DATA_VOLUMES), seeding instead"
    run_task "$name" migrate
    run_task "$name" seed
    compose_env "$name" up -d --remove-orphans >&2
    echo fresh >"$(env_dir "$name")/mode"
    return
  fi
  copy_data "$name" "$volumes"
  run_task "$name" migrate
  compose_env "$name" up -d --remove-orphans >&2
  echo forked >"$(env_dir "$name")/mode"
}

upgrade() {
  local name=$1 tag=$2
  log "$name: upgrading to $tag"
  prepare_env "$name" "$tag"
  run_task "$name" migrate
  compose_env "$name" up -d --remove-orphans >&2
  echo upgraded >"$(env_dir "$name")/mode"
}

parse_tag_args() {
  TAG='' FRESH=''
  while (($#)); do
    case $1 in
      --tag) TAG=$2 && shift 2 ;;
      --fresh) FRESH=1 && shift ;;
      *) die "unknown argument $1" ;;
    esac
  done
  TAG=${TAG:-$(default_tag)}
  [[ -n $TAG ]] || die "no --tag and $SOURCE is not a git checkout"
}

cmd_deploy() {
  local name=$1
  shift
  check_name "$name"
  parse_tag_args "$@"
  load_config
  load_secrets
  images_exist "$TAG" || die "images for $TAG do not exist; run build first"
  if env_exists "$name"; then
    upgrade "$name" "$TAG"
  elif [[ $name == main ]]; then
    create_fresh main "$TAG"
  else
    [[ -n $FRESH ]] || env_exists main || {
      log "the baseline does not exist"
      exit 4
    }
    if (($(pr_env_count) >= MAX_ENVS)) && [[ ! -d $(env_dir "$name") ]]; then
      log "limit reached: $MAX_ENVS PR environments"
      exit 3
    fi
    if (($(free_mb) < MIN_FREE_MB)); then
      log "limit reached: $(free_mb)MB available memory, less than $MIN_FREE_MB MB"
      exit 3
    fi
    if [[ -n $FRESH ]]; then
      create_fresh "$name" "$TAG"
    else
      create_forked "$name" "$TAG"
    fi
  fi
  [[ $INGRESS != shared ]] || ingress_route "$name"
  wait_healthy "$name"
  touch "$(env_dir "$name")/initialized"
  if [[ $INGRESS == shared ]]; then
    # The ingress's wildcard certificate covers the name; it is issued and renewed apart from deploys.
    log "$name: ready at $(app_url "$name")"
    app_url "$name" >&3
    return
  fi
  # The environment exists from here on (the next deploy upgrades it); only browsers cannot connect yet.
  https_enabled "$name" ||
    fail https "$name: the tailnet does not issue HTTPS certificates, browsers cannot open $(app_url "$name")"
  # A missing certificate is a timing problem between Tailscale and Let's Encrypt, not the PR's: the deploy
  # succeeds, the PR comment says so, and the sidecar keeps trying (docs/design.md section 7).
  local cert_error
  if cert_error=$(issue_cert "$name"); then
    compose_env "$name" exec -T ts rm -f /var/lib/tailscale/tp-cert-failed >/dev/null 2>&1 || true
    serve_https "$name" on
  else
    serve_https "$name" off
    retry_cert_later "$name"
    notice cert "$name: no HTTPS certificate yet for $(app_url "$name"): $cert_error"
  fi
  log "$name: ready at $(app_url "$name")"
  app_url "$name" >&3
}

# Log out first so the node leaves the tailnet at once and a recreated environment keeps its name.
cmd_destroy() {
  local name=$1 force=${2:-} dir volume
  check_name "$name"
  [[ $name != main || $force == --force ]] || die "destroying the baseline needs --force; use reset to start it over"
  dir=$(env_dir "$name")
  ingress_unroute "$name"
  if [[ -f $dir/compose-files ]]; then
    compose_env "$name" exec -T ts tailscale logout >/dev/null 2>&1 || true
    compose_env "$name" --profile tasks down -v --remove-orphans >&2 || true
  fi
  # Volumes left behind by a half-created environment.
  for volume in $(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT-$name"); do
    docker volume rm "$volume" >/dev/null 2>&1 || true
  done
  rm -rf "$dir"
  log "$name: destroyed"
}

cmd_reset() {
  local name=$1
  shift
  check_name "$name"
  if [[ $name == main ]]; then
    # The baseline keeps its Tailscale node (and so its address); its data starts over.
    if env_exists main; then cmd_backup; fi
    rm -f "$(env_dir main)/initialized"
  else
    cmd_destroy "$name"
  fi
  cmd_deploy "$name" "$@"
}

cmd_backup() {
  local dir volume src stamp
  dir=$(env_dir main)
  env_exists main || {
    log "the baseline does not exist, nothing to back up"
    return
  }
  # The baseline's own copy of the configuration describes its volumes.
  load_config "$(cat "$dir/config-dir")"
  local volumes
  volumes=$(data_volumes main)
  [[ -n $volumes ]] || {
    log "no data volumes, nothing to back up"
    return
  }
  stamp=$ROOT/backups/main-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$stamp"
  log "backing up ${volumes//$'\n'/ } (the baseline pauses meanwhile)"
  stop_services main
  local rc=0
  for volume in $volumes; do
    src=$(volume_of main "$volume")
    [[ -n $src ]] || continue
    docker run --rm --entrypoint tar -v "$src:/data:ro" "$TS_IMAGE" czf - -C /data . >"$stamp/$volume.tar.gz" || rc=1
  done
  start_services main
  ((rc == 0)) || die "backup failed"
  log "backed up to $stamp"
  find "$ROOT/backups" -mindepth 1 -maxdepth 1 -name 'main-*' -type d | sort -r | tail -n +$((KEEP_BACKUPS + 1)) |
    xargs -r rm -rf
}

cmd_prune() {
  local open=" $* " dir name used image
  for dir in "$ROOT"/envs/pr-*; do
    [[ -d $dir ]] || continue
    name=$(basename "$dir")
    [[ $open == *" ${name#pr-} "* ]] || cmd_destroy "$name"
  done
  used=$(cat "$ROOT"/envs/*/tag 2>/dev/null | sort -u || true)
  for image in $(docker images --filter "label=tailnet-preview.project=$PROJECT" --format '{{.Repository}}:{{.Tag}}'); do
    grep -qx "${image##*:}" <<<"$used" || docker rmi "$image" >/dev/null 2>&1 || true
  done
  docker image prune -f >/dev/null
  docker builder prune -f --filter until=168h >/dev/null 2>&1 || true
}

redact() { sed -E 's/(tskey-[a-z]+-)[A-Za-z0-9_-]+/\1***/g'; }

# Read-only; every check continues on failure.
cmd_doctor() {
  local name=$1 dir entry svc
  check_name "$name"
  dir=$(env_dir "$name")
  [[ -f $dir/compose-files ]] || {
    echo "$name does not exist on this host"
    return
  }
  # The copied configuration describes this environment, even if the checkout has changed since.
  load_config "$(cat "$dir/config-dir")"
  echo "== url: $(app_url "$name") (tag $(cat "$dir/tag" 2>/dev/null), $(cat "$dir/mode" 2>/dev/null || echo 'not deployed'))"
  echo "== containers"
  compose_env "$name" ps -a || true
  if [[ $INGRESS == shared ]]; then
    doctor_shared "$name"
    return
  fi
  echo "== tailscale node"
  compose_env "$name" exec -T ts tailscale status --self --peers=false 2>&1 | redact || true
  echo "== https certificates"
  if https_enabled "$name"; then
    echo "enabled for the tailnet; the sidecar's last certificate messages:"
    grep -E 'cert\(|tls-cert' <<<"$(compose_env "$name" logs --no-color --no-log-prefix ts 2>&1)" | tail -n 4 || echo "(none)"
    echo "background retries (after a failed request during deploy):"
    compose_env "$name" exec -T ts tail -n 4 /var/lib/tailscale/tp-cert-retry.log 2>/dev/null || echo "(none)"
  else
    echo "NOT enabled for the tailnet (docs/troubleshooting.md)"
  fi
  echo "== tailscale serve"
  compose_env "$name" exec -T ts tailscale serve status 2>&1 || true
  echo "== upstreams, requested from the sidecar"
  local targets=("$HTTP$HEALTH_PATH")
  for entry in $PORTS; do targets+=("${entry#*=}/"); done
  for entry in "${targets[@]}"; do
    printf 'http://%s: ' "$entry"
    if compose_env "$name" exec -T ts wget -q -O /dev/null "http://$entry" 2>&1; then echo ok; fi
  done
  echo "== data volumes"
  for entry in $(data_volumes "$name"); do echo "$entry: $(volume_of "$name" "$entry" || true)"; done
  for svc in ts $(app_services "$name"); do
    echo "== logs of $svc"
    compose_env "$name" logs --no-color --tail 30 "$svc" 2>&1 | redact || true
  done
}

doctor_shared() {
  local name=$1 entry svc acme
  echo "== shared ingress ($INGRESS_PROJECT, $INGRESS_DIR)"
  compose_ingress ps -a 2>&1 || echo "(not set up: it starts with the first deploy)"
  ingress_exec tailscale status --self --peers=false 2>&1 | redact || true
  echo "== route ($INGRESS_DIR/routes/$PROJECT-$name.yml)"
  cat "$INGRESS_DIR/routes/$PROJECT-$name.yml" 2>/dev/null || echo "(none)"
  echo "== certificate *.$INGRESS_DOMAIN"
  if [[ -z ${TP_INGRESS_DNS_PROVIDER:-} ]]; then
    echo "no TP_INGRESS_DNS_PROVIDER: Traefik serves its self-signed default certificate"
  else
    acme=$(docker exec "$(ingress_container traefik)" cat /data/acme.json 2>/dev/null || true)
    if [[ $acme == *"\"*.$INGRESS_DOMAIN\""* ]]; then echo "issued"; else echo "NOT issued yet; Traefik's last ACME messages:"; fi
    grep -iE 'acme|certificate|error' <<<"$(docker logs --tail 200 "$(ingress_container traefik)" 2>&1)" | tail -n 5 || true
  fi
  echo "== upstreams, requested from the ingress"
  for entry in "443=$HTTP" $PORTS; do
    printf 'http://%s: ' "$(upstream_of "$name" "${entry#*=}")"
    if ingress_exec wget -q -O /dev/null "http://$(upstream_of "$name" "${entry#*=}")/" 2>&1; then echo ok; fi
  done
  echo "== data volumes"
  for entry in $(data_volumes "$name"); do echo "$entry: $(volume_of "$name" "$entry" || true)"; done
  for svc in $(app_services "$name"); do
    echo "== logs of $svc"
    compose_env "$name" logs --no-color --tail 30 "$svc" 2>&1 | redact || true
  done
}

# Static checks of the configuration in TP_CONFIG against the current checkout, using a throwaway
# environment: nothing is built, started or written outside a temporary directory. Needs the docker CLI
# (for `docker compose config`), not a running daemon.
cmd_validate() {
  local errors=0 warnings=0 tmp env file entry svc vol task image volumes services running files=()
  err() {
    echo "ERROR  $*"
    errors=$((errors + 1))
  }
  warn() {
    echo "WARN   $*"
    warnings=$((warnings + 1))
  }
  info() { echo "ok     $*"; }
  has() { grep -qx "$1" <<<"$2"; }
  uses() { grep -q "$1" "${files[@]}"; }

  load_config
  info "config.env parsed ($CONFIG/config.env)"
  for entry in $IMAGES; do
    if [[ $entry == *=* && -f $SOURCE/${entry#*=} ]]; then
      info "image ${entry%%=*} builds from ${entry#*=}"
    else
      err "IMAGES entry '$entry': no Dockerfile at $SOURCE/${entry#*=}"
    fi
  done

  # A throwaway environment with placeholder secrets.
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT
  ROOT=$tmp TS_OAUTH_SECRET=tskey-validate TS_TAGS=tag:preview env=$tmp/envs/pr-0
  for entry in $SECRETS; do printf -v "$entry" 'validate-%s' "$entry"; done
  mkdir -p "$env"
  printf 'https://%s-pr-0.example.ts.net\n' "$PROJECT" >"$env/url"
  if ! (write_env pr-0 validate --snapshot) >"$tmp/out" 2>&1; then
    err "the compose files do not merge:"
    sed 's/^/         /' "$tmp/out"
    echo "$errors error(s), $warnings warning(s)"
    exit 1
  fi
  if ! compose_env pr-0 --profile tasks config -q 2>"$tmp/out"; then
    err "docker compose rejects the merged configuration:"
    sed 's/^/         /' "$tmp/out"
  fi
  # The project's own files: between the sidecar overlay (first) and the isolation override (last).
  mapfile -t files < <(sed '1d;$d' "$env/compose-files")
  info "compose files, merged in order: ${files[*]#"$env"/src/}"
  info "relative paths in them resolve against ./$(realpath -m --relative-to="$env/src" "$(cat "$env/project-dir")")"
  services=$(compose_env pr-0 --profile tasks config --services 2>/dev/null || true)
  running=$(compose_env pr-0 config --services 2>/dev/null || true)
  for file in "${files[@]}"; do
    if grep -Eq '^  ts:' "$file"; then err "${file#"$env"/src/} defines a service named ts, reserved for the Tailscale sidecar"; fi
  done

  svc=${HTTP%%:*}
  if has "$svc" "$running"; then
    info "HTTPS port 443 proxies to $HTTP; ready when $HEALTH_PATH answers"
  else
    err "HTTP=$HTTP: no running service '$svc' (services: ${running//$'\n'/ })"
  fi
  for entry in $PORTS; do
    svc=${entry#*=} svc=${svc%%:*}
    if has "$svc" "$running"; then info "HTTPS port ${entry%%=*} proxies to ${entry#*=}"; else err "PORTS entry '$entry': no running service '$svc'"; fi
  done

  volumes=$(compose_env pr-0 config --volumes 2>/dev/null | grep -vx ts-state || true)
  case $DATA_VOLUMES in
    "" | none) info "DATA_VOLUMES=none: every PR environment starts with empty volumes and is seeded" ;;
    auto)
      if [[ -n $volumes ]]; then
        info "PR environments copy every named volume from the baseline: ${volumes//$'\n'/ }"
      else
        warn "no named volumes: PR environments cannot copy the baseline's data and are seeded instead"
      fi
      ;;
    *)
      for vol in $DATA_VOLUMES; do
        if has "$vol" "$volumes"; then
          info "PR environments copy volume $vol from the baseline"
        else
          err "DATA_VOLUMES entry '$vol' is not a volume of the compose files (volumes: ${volumes//$'\n'/ })"
        fi
      done
      ;;
  esac
  # A fixed or external volume would be shared by every environment.
  for vol in $volumes; do
    entry=$(compose_env pr-0 config 2>/dev/null | awk -v v="$vol" '
      /^volumes:/ { top = 1; next } /^[^ ]/ { top = 0 }
      top && $0 ~ "^  " v ":" { inside = 1; next } top && /^  [^ ]/ { inside = 0 }
      inside && /^    external: true/ { print "external"; exit } inside && /^    name:/ { name = $2 } END { print name }' | sed -n 1p)
    case $entry in
      '' | "$PROJECT-pr-0_$vol") ;;
      external) warn "volume $vol is external: every environment shares it" ;;
      *) err "volume $vol has a fixed name ($entry): every environment would share it; remove its name:" ;;
    esac
  done

  for task in migrate seed; do
    if ! has "$task" "$services"; then
      case $task in
        migrate) info "no migrate task: the application migrates on start, or needs no migrations" ;;
        seed) info "no seed task: a new baseline starts with empty data" ;;
      esac
    elif has "$task" "$running"; then
      err "service $task must be in the tasks profile (profiles: [tasks]); otherwise it keeps running"
    else
      info "task $task"
    fi
  done

  uses 'TP_URL' || warn "no compose file uses \${TP_URL}: the application does not learn its own address (logins, redirects and cookies usually need it)"
  for entry in $IMAGES; do
    uses "$(image_var "${entry%%=*}")" || warn "image ${entry%%=*} is built, but no compose file uses \${$(image_var "${entry%%=*}")}"
  done
  for entry in $SECRETS; do
    uses "\${$entry" || warn "secret $entry is generated, but no compose file uses \${$entry}"
  done
  for image in $(compose_env pr-0 --profile tasks config --images 2>/dev/null | sort -u); do
    [[ $image == "$PROJECT"-* || $image == "$TS_IMAGE" ]] || info "pulled from a registry: $image"
  done
  echo "$errors error(s), $warnings warning(s)"
  ((errors == 0)) || exit 1
}

# A commented starting point in TP_CONFIG; fills in what can be seen in the repository.
cmd_init() {
  local file compose='' dockerfiles images=''
  [[ ! -e $CONFIG ]] || die "$CONFIG already exists"
  for file in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    if [[ -f $SOURCE/$file ]]; then compose=$file && break; fi
  done
  dockerfiles=$(cd "$SOURCE" && find . -name node_modules -prune -o -name .git -prune -o \
    -type f \( -name Dockerfile -o -name '*.Dockerfile' \) -print 2>/dev/null | sed 's|^\./||' | sort | sed -n 1,10p)
  for file in $dockerfiles; do
    images+="$(basename "$(dirname "$file")" | sed 's/^\.$/app/')=$file "
  done
  mkdir -p "$CONFIG"
  sed -e "s|@IMAGES@|${images% }|" \
    -e "s|@COMPOSE_FILES@|${compose:+../$compose }compose.yaml|" "$LIB/templates/config.env" >"$CONFIG/config.env"
  if [[ -n $compose ]]; then
    cp "$LIB/templates/compose.override.yaml" "$CONFIG/compose.yaml"
  else
    cp "$LIB/templates/compose.yaml" "$CONFIG/compose.yaml"
  fi
  log "wrote $CONFIG/config.env and $CONFIG/compose.yaml${compose:+ (on top of ./$compose)}"
  log "next: fill in the TODOs (docs/configuring.md), then run: tailnet-preview validate"
}

cmd_info() {
  local dir
  dir=$(env_dir "$1")
  [[ -d $dir ]] || exit 2
  printf 'url=%s\ntag=%s\nmode=%s\n' "$(cat "$dir/url" 2>/dev/null)" "$(cat "$dir/tag" 2>/dev/null)" "$(cat "$dir/mode" 2>/dev/null)"
}

cmd_list() {
  local dir
  for dir in "$ROOT"/envs/*; do
    [[ -d $dir ]] || continue
    printf '%-10s %-13s %-9s %s\n' "$(basename "$dir")" "$(cat "$dir/tag" 2>/dev/null)" \
      "$(cat "$dir/mode" 2>/dev/null)" "$(cat "$dir/url" 2>/dev/null)"
  done
}

cmd_host_check() {
  local ok=1
  check() {
    if eval "$2" >/dev/null 2>&1; then echo "ok    $1"; else
      echo "FAIL  $1${3:+ – $3}"
      ok=0
    fi
  }
  check "docker daemon reachable" "docker info" "install Docker and add this user to the docker group"
  check "docker compose v2" "docker compose version"
  check "flock" "command -v flock" "install util-linux"
  check "git" "command -v git"
  check "TS_OAUTH_SECRET" "[[ -n \${TS_OAUTH_SECRET:-} ]] || grep -q '^TS_OAUTH_SECRET=.' '$HOST_CONFIG'" \
    "write it to $HOST_CONFIG (docs/host-setup.md)"
  check "host configuration not readable by others" "[[ ! -f '$HOST_CONFIG' ]] || [[ \$(stat -c %a '$HOST_CONFIG') == 600 ]]" \
    "chmod 600 $HOST_CONFIG"
  echo "info  ingress: $INGRESS"
  if [[ $INGRESS == shared ]]; then
    check "TUN device for the ingress's Tailscale node" "[[ -c /dev/net/tun ]]"
    check "TP_INGRESS_DNS_PROVIDER (wildcard certificate by DNS-01)" "[[ -n \${TP_INGRESS_DNS_PROVIDER:-} ]]" \
      "without it the ingress serves a self-signed certificate (docs/host-setup.md)"
  fi
  echo "info  available memory: $(free_mb) MB"
  echo "info  free disk in $HOME: $(df -Pm "$HOME" | awk 'NR == 2 { print $4 }') MB"
  ((ok)) || exit 1
}

# State-changing commands of a project run one at a time: a fork pauses the baseline and must not
# interleave with the baseline's own upgrade.
lock() {
  mkdir -p "$ROOT"
  exec 9>"$ROOT/.lock"
  flock -w 1800 9 || die "timed out waiting for another deploy of $PROJECT"
}

main() {
  local cmd=${1:-}
  shift || true
  case $cmd in
    version | -h | --help | help | '') ;;
    *) load_ingress_settings ;;
  esac
  case $cmd in
    deploy | reset | destroy | backup | prune) lock ;;
  esac
  case $cmd in
    build) cmd_build "$@" ;;
    has)
      check_name "${1:-}"
      env_exists "$1" || exit 2
      ;;
    # stdout carries only the URL; everything else goes to stderr.
    deploy) cmd_deploy "$@" 3>&1 1>&2 ;;
    reset) cmd_reset "$@" 3>&1 1>&2 ;;
    destroy) cmd_destroy "$@" ;;
    stop | start)
      check_name "${1:-}"
      compose_env "$1" "$cmd"
      ;;
    url)
      check_name "${1:-}"
      app_url "$1"
      ;;
    info)
      check_name "${1:-}"
      cmd_info "$1"
      ;;
    list) cmd_list ;;
    backup) cmd_backup ;;
    prune) cmd_prune "$@" ;;
    doctor) cmd_doctor "$@" ;;
    validate) cmd_validate ;;
    init) cmd_init ;;
    compose)
      check_name "${1:-}"
      local name=$1
      shift
      compose_env "$name" "$@"
      ;;
    host-check) cmd_host_check ;;
    ingress)
      [[ $INGRESS == shared ]] || die "the host does not use the shared ingress (TP_INGRESS=shared, docs/host-setup.md)"
      case ${1:-} in
        up)
          load_secrets_ts
          ensure_ingress
          log "ingress up at $(cat "$INGRESS_DIR/ip"); the tailnet's split DNS must send $INGRESS_DOMAIN there (docs/host-setup.md)"
          ;;
        down) compose_ingress down "${@:2}" ;;
        status) compose_ingress ps -a ;;
        *) die "usage: tailnet-preview ingress up | down [-v] | status" ;;
      esac
      ;;
    version) echo "$VERSION" ;;
    -h | --help | help) sed -n '2,27p' "$0" | sed -E 's/^# ?//' ;;
    *)
      sed -n '2,26p' "$0" | sed -E 's/^# ?//' >&2
      exit 1
      ;;
  esac
}

main "$@"
