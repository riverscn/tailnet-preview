# tailnet-preview configuration. Guide: docs/configuring.md of tailnet-preview; reference: docs/design.md 5.1.
# Check it with: tailnet-preview validate

# Images built from this repository: name=path/to/Dockerfile, build context is the repository root.
# Compose files use them as ${TP_IMAGE_<NAME>}.
# TODO: check the names and paths found by `tailnet-preview init`.
IMAGES=@IMAGES@

# Compose files merged in order, relative to this directory. Relative paths inside them resolve against
# the directory of the first file.
COMPOSE_FILES=@COMPOSE_FILES@

# TODO: the service:port that serves the web application (container port, not a published port).
HTTP=web:80

# Path that answers 2xx/3xx once the application is up.
HEALTH_PATH=/

# Extra HTTPS ports, e.g. a mail catcher: PORTS=8025=mailpit:8025
#PORTS=

# Volumes copied from the baseline into new PR environments. Default: every named volume.
# DATA_VOLUMES=none starts every PR environment with empty data.
#DATA_VOLUMES=db-data

# Random values generated once per project and identical in every environment, e.g. database passwords.
#SECRETS=DB_PASSWORD SESSION_SECRET
