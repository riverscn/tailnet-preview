#!/bin/sh
# shellcheck disable=SC2154 # TS_HOSTNAME is set on the container by compose.overlay.yaml
# Fake tailscale CLI. In /var/lib/tailscale: `no-https` makes the tailnet behave as if HTTPS certificates
# were disabled; `cert-invalid` and `cert-ratelimited` (holding the seconds until the limit lifts) make
# certificate requests fail like Let's Encrypt does; every request is appended to `cert-requests`. `starting` holds "S N": after S more status calls, N
# calls report a sidecar that restarted and is still logging in. `cert-slow` makes certificate requests hang.
# An issued certificate is kept in certs/, like tailscaled does; `serve status` shows the active serve
# configuration (TS_SERVE_CONFIG), or nothing while HTTPS is off.
state=/var/lib/tailscale
# `name-taken`: the tailnet already has a device with this hostname, so the node gets a suffix.
if [ -f $state/name-taken ]; then name="${TS_HOSTNAME}-1"; else name="${TS_HOSTNAME}"; fi
domain="${name}.fake-tailnet.ts.net"
case "$1 $2" in
  'status --json')
    backend=Running
    if [ -s $state/starting ]; then
      read -r skip count <$state/starting
      if [ "$skip" -gt 0 ]; then
        echo "$((skip - 1)) $count" >$state/starting
      elif [ "$count" -gt 0 ]; then
        echo "0 $((count - 1))" >$state/starting
        backend=NoState
      fi
    fi
    if [ -f $state/no-https ] || [ $backend != Running ]; then certs=null; else certs="[\"$domain\"]"; fi
    cat <<JSON
{
  "BackendState": "${backend}",
  "Self": {
    "HostName": "${TS_HOSTNAME}",
    "DNSName": "${domain}."
  },
  "CertDomains": ${certs},
  "Peer": {
    "nodekey:1": { "DNSName": "someone-else.fake-tailnet.ts.net." }
  }
}
JSON
    ;;
  'status --self') echo "100.64.0.1  ${TS_HOSTNAME}  ${domain}  linux  -" ;;
  'serve status') cat /var/lib/tailscale/tp-serve.json 2>/dev/null || echo 'No serve config' ;;
  'logout '*) echo "logged out" ;;
  'cert '*)
    echo "$*" >>$state/cert-requests
    if [ -f $state/cert-slow ]; then sleep 30; fi
    if [ -f $state/cert-ratelimited ]; then
      # Like Let's Encrypt: refused until a time given in the file (seconds from now, default 3); tailscaled
      # also writes the error to its log, which the engine reads.
      wait=$(cat $state/cert-ratelimited)
      until=$(date -u -d "@$(($(date +%s) + ${wait:-3}))" "+%Y-%m-%d %H:%M:%S")
      msg="getCertPEM: 429 urn:ietf:params:acme:error:rateLimited: too many failed authorizations (5) for \"$domain\" in the last 1h0m0s, retry after $until UTC"
      echo "cert(\"$domain\"): $msg" >/proc/1/fd/1
      echo "$msg" >&2
      exit 1
    elif [ -f $state/cert-invalid ]; then
      echo "acme: authorization error for $domain: 403 urn:ietf:params:acme:error:unauthorized: Incorrect TXT record" >&2
      exit 1
    fi
    mkdir -p $state/certs && echo fake >"$state/certs/$domain.crt"
    echo "Wrote public cert"
    ;;
  *)
    echo "fake tailscale: unsupported: $*" >&2
    exit 1
    ;;
esac
